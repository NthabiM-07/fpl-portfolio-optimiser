{
  "name": "fpl-portfolio-optimiser",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "streamlit run src/fplopt/app.py --server.headless true",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit demo", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
